<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/collectionCardRoot"
    style="@style/Widget.PatriGO.Surface.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/collectionCardNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TextAppearance.PatriGO.Value" />

        <ImageButton
            android:id="@+id/collectionDeleteButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/schema_delete_table_button"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/amber" />
    </LinearLayout>

    <TextView
        android:id="@+id/collectionCardDescriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/TextAppearance.PatriGO.Body.Muted" />

    <TextView
        android:id="@+id/collectionCardMetaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        style="@style/TextAppearance.PatriGO.Caption" />

    <LinearLayout
        android:id="@+id/collectionCardBadgesRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/collectionCardKindBadgeText"
            style="@style/Widget.PatriGO.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PatriGO.Tag"
            android:visibility="gone" />

        <TextView
            android:id="@+id/collectionCardMasterActionText"
            style="@style/Widget.PatriGO.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textAppearance="@style/TextAppearance.PatriGO.Tag" />
    </LinearLayout>

    <TextView
        android:id="@+id/collectionCardHealthText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/TextAppearance.PatriGO.Status.Warning"
        android:visibility="gone" />
</LinearLayout>
