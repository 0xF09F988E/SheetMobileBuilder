<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recordCreateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        style="@style/Widget.PatriGO.Surface.Panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.PatriGO.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/record_create_table_label" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.PatriGO.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/record_create_table_hint"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/recordCreateTableSelector"
                style="@style/Widget.PatriGO.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/recordCreateStatusText"
            style="@style/TextAppearance.PatriGO.Body.Md.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/record_create_status_no_tables" />
    </LinearLayout>

    <TextView
        android:id="@+id/recordCreateFieldsEmptyText"
        style="@style/TextAppearance.PatriGO.Body.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/record_create_fields_empty"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recordCreateFieldsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/recordCreateClearButton"
            style="@style/Widget.PatriGO.Button.Xs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/record_create_clear_button" />

        <Button
            android:id="@+id/recordCreateSaveButton"
            style="@style/Widget.PatriGO.Button.Xs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/record_create_save_button" />
    </LinearLayout>
</LinearLayout>
