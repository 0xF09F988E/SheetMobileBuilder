<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.PatriGO.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dashboard_collection_label">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dashboardCollectionSelector"
                style="@style/Widget.PatriGO.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.PatriGO.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/dashboard_group_field_label">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dashboardFieldSelector"
                style="@style/Widget.PatriGO.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.PatriGO.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/dashboard_review_filter_label">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dashboardReviewStatusSelector"
                style="@style/Widget.PatriGO.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/dashboardGenerateButton"
            style="@style/Widget.PatriGO.Button.Md"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/dashboard_generate_button"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/dashboard_review_section_title"
            style="@style/TextAppearance.PatriGO.SectionTitle" />

        <TextView
            android:id="@+id/dashboardReviewCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dashboard_waiting_generate"
            style="@style/TextAppearance.PatriGO.Body.Md.Muted" />

        <LinearLayout
            android:id="@+id/dashboardReviewCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dashboardReviewEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dashboard_waiting_generate"
            style="@style/TextAppearance.PatriGO.Body.Md.Muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/dashboard_group_section_title"
            style="@style/TextAppearance.PatriGO.SectionTitle" />

        <TextView
            android:id="@+id/dashboardGroupedCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dashboard_waiting_generate"
            style="@style/TextAppearance.PatriGO.Body.Md.Muted" />

        <LinearLayout
            android:id="@+id/dashboardGroupedCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dashboardGroupedEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dashboard_waiting_generate"
            style="@style/TextAppearance.PatriGO.Body.Md.Muted" />

        <TextView
            android:id="@+id/dashboardStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dashboard_status_loading"
            style="@style/TextAppearance.PatriGO.Body.Md.Muted" />
    </LinearLayout>
</ScrollView>
