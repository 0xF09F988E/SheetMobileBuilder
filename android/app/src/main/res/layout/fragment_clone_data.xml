<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                style="@style/Widget.PatriGO.Surface.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PatriGO.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clone_current_title" />

                <TextView
                    style="@style/TextAppearance.PatriGO.Body.Md.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/clone_current_summary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.PatriGO.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_total_tables" />

                        <TextView
                            android:id="@+id/cloneTotalTablesText"
                            style="@style/TextAppearance.PatriGO.MetricValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/clone_summary_placeholder" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.PatriGO.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_total_records" />

                        <TextView
                            android:id="@+id/cloneTotalRecordsText"
                            style="@style/TextAppearance.PatriGO.MetricValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/clone_summary_placeholder" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.PatriGO.Surface.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PatriGO.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clone_export_title" />

                <TextView
                    style="@style/TextAppearance.PatriGO.Body.Md.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/clone_export_summary" />

                <Button
                    android:id="@+id/cloneExportButton"
                    style="@style/Widget.PatriGO.Button.Md"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/clone_export_button" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.PatriGO.Surface.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PatriGO.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clone_import_title" />

                <TextView
                    style="@style/TextAppearance.PatriGO.Body.Md.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/clone_import_summary" />

                <Button
                    android:id="@+id/cloneImportButton"
                    style="@style/Widget.PatriGO.Button.Danger.Md"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/clone_import_button" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.PatriGO.Surface.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PatriGO.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clone_result_title" />

                <TextView
                    android:id="@+id/cloneStatusText"
                    style="@style/TextAppearance.PatriGO.Body.Md.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/clone_status_ready" />

                <TextView
                    style="@style/TextAppearance.PatriGO.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/clone_result_file_label" />

                <TextView
                    android:id="@+id/cloneResultFileText"
                    style="@style/TextAppearance.PatriGO.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/app_surface_card_background"
                    android:padding="12dp"
                    android:text="@string/clone_result_file_empty" />

                <TextView
                    style="@style/TextAppearance.PatriGO.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/clone_result_summary_label" />

                <TextView
                    android:id="@+id/cloneResultSummaryText"
                    style="@style/TextAppearance.PatriGO.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/app_surface_card_background"
                    android:padding="12dp"
                    android:text="@string/clone_result_summary_empty" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/cloneLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/cloneLoadingText"
                style="@style/TextAppearance.PatriGO.Body.Md"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/clone_loading_default"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
