<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dialogFieldEditorListInputLayout"
            style="@style/Widget.PatriGO.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dialogFieldEditorListInput"
                style="@style/Widget.PatriGO.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="70dp"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dialogFieldEditorListClearButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/app_icon_button_background"
                android:contentDescription="@string/asset_dialog_clear"
                android:padding="0dp"
                android:src="@drawable/ic_dialog_clear"
                android:tint="@color/muted_ink" />

            <ImageButton
                android:id="@+id/dialogFieldEditorListExpandButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="1dp"
                android:background="@drawable/app_icon_button_background"
                android:contentDescription="@string/asset_dialog_expand"
                android:padding="0dp"
                android:src="@drawable/ic_dialog_expand"
                android:tint="@color/muted_ink" />
        </LinearLayout>
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialogFieldEditorListRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true" />

</LinearLayout>
