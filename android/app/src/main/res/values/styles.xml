<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/forest</item>
        <item name="colorPrimaryContainer">@color/forest_dark</item>
        <item name="colorSecondary">@color/amber</item>
        <item name="colorTertiary">@color/amber</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorSurfaceContainer">@color/paper_alt</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted_ink</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="textInputStyle">@style/Widget.PatriGO.TextInputLayout</item>
        <item name="buttonStyle">@style/Widget.PatriGO.Button.Md</item>
        <item name="materialButtonStyle">@style/Widget.PatriGO.Button.Md</item>
    </style>

    <style name="Widget.PatriGO.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/paper</item>
        <item name="hintTextColor">@color/muted_ink</item>
    </style>

    <style name="Widget.PatriGO.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted_ink</item>
    </style>

    <style name="TextAppearance.PatriGO.ScreenTitle" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PatriGO.ScreenTitle.Lg" parent="TextAppearance.PatriGO.ScreenTitle">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.PatriGO.ScreenCode" parent="">
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.PatriGO.SectionTitle" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PatriGO.SectionTitle.Lg" parent="TextAppearance.PatriGO.SectionTitle">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.PatriGO.Body" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.PatriGO.Body.Muted" parent="TextAppearance.PatriGO.Body">
        <item name="android:textColor">@color/muted_ink</item>
    </style>

    <style name="TextAppearance.PatriGO.Body.Md" parent="TextAppearance.PatriGO.Body">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.PatriGO.Body.Md.Muted" parent="TextAppearance.PatriGO.Body.Md">
        <item name="android:textColor">@color/muted_ink</item>
    </style>

    <style name="TextAppearance.PatriGO.Caption" parent="">
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.PatriGO.Label" parent="">
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.PatriGO.Value" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PatriGO.Value.Lg" parent="TextAppearance.PatriGO.Value">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.PatriGO.MetricValue" parent="TextAppearance.PatriGO.Value">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.PatriGO.Tag" parent="">
        <item name="android:textColor">@color/forest_dark</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PatriGO.Status.Warning" parent="">
        <item name="android:textColor">@color/amber</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearanceOverlay.PatriGO.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.PatriGO.Button.Base" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.PatriGO.Button</item>
        <item name="backgroundTint">@color/forest</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/forest_dark</item>
    </style>

    <style name="Widget.PatriGO.Button.Md" parent="Widget.PatriGO.Button.Base">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Widget.PatriGO.Button.Xs" parent="Widget.PatriGO.Button.Base">
        <item name="android:minHeight">34dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Widget.PatriGO.Surface.Panel" parent="">
        <item name="android:background">@drawable/app_surface_panel_background</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Widget.PatriGO.Surface.Card" parent="">
        <item name="android:background">@drawable/app_surface_card_background</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Widget.PatriGO.Tag" parent="">
        <item name="android:background">@drawable/app_tag_background</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
