<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recordCreateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            style="@style/Widget.PatriGO.Surface.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.PatriGO.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/record_create_table_label" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.PatriGO.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/record_create_table_hint"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/recordCreateTableSelector"
                    style="@style/Widget.PatriGO.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/recordCreateStatusText"
                style="@style/TextAppearance.PatriGO.Body.Md.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/record_create_status_no_tables" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/recordCreateProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/recordCreateFieldsEmptyText"
            style="@style/TextAppearance.PatriGO.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/record_create_fields_empty"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/recordCreateFieldsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper_alt"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/recordCreateClearButton"
            style="@style/Widget.PatriGO.Button.Danger.Md"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/record_create_clear_button" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/recordCreateSaveButton"
                style="@style/Widget.PatriGO.Button.Success.Md"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/record_create_save_button" />

            <ProgressBar
                android:id="@+id/recordCreateSaveProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="34dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/paper"
                android:visibility="gone" />

            <TextView
                android:id="@+id/recordCreateSaveLoadingText"
                style="@style/TextAppearance.PatriGO.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="10dp"
                android:text="@string/record_create_save_button_loading"
                android:textColor="@color/paper"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
