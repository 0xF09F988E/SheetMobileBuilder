<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.PatriGO.Surface.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/dashboardTableNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.PatriGO.SectionTitle" />

    <TextView
        android:id="@+id/dashboardTableSlugText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/TextAppearance.PatriGO.Body.Muted" />

    <TextView
        android:id="@+id/dashboardTableCountText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        style="@style/TextAppearance.PatriGO.Value" />
</LinearLayout>
